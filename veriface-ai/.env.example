# Supabase Configuration
# Replace these with your own Supabase project credentials from Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# VeriFace Core endpoint; use a port separate from the document detector.
VITE_API_URL=http://127.0.0.1:8001
VITE_DOCUMENT_AI_API_URL=http://127.0.0.1:8002/api/v1/detect
